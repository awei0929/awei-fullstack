# NestJS 在本机运行，因此连接本机映射端口。
# authSource=admin 表示在 admin 数据库验证初始化账号，数据写入 awei 数据库。
MONGODB_URI=mongodb://awei_admin:replace_with_the_same_password@127.0.0.1:27017/awei?authSource=admin

# 固定随机密钥（至少32字符）；生成一次并保存，不能每次启动变化。
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
# 固定绝对会话期限，单位毫秒；默认7天。
SESSION_MAX_AGE_MS=604800000
# 登录/注册合计每IP、登录每账号限流；窗口单位毫秒。
AUTH_IP_LIMIT=30
AUTH_ACCOUNT_LIMIT=10
AUTH_RATE_WINDOW_MS=900000
# 生产设置NODE_ENV=production启用Secure Cookie，需要HTTPS。
# TRUST_PROXY只允许显式可信代理IP/子网列表；默认不信任X-Forwarded-For。
# TRUST_PROXY=loopback
