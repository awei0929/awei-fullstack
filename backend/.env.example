# NestJS 在本机运行，因此连接本机映射端口。
# authSource=admin 表示在 admin 数据库验证初始化账号，数据写入 awei 数据库。
MONGODB_URI=mongodb://awei_admin:replace_with_the_same_password@127.0.0.1:27017/awei?authSource=admin

# 固定随机密钥（至少32字符）；生成一次并保存，不能每次启动变化。
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
# 固定绝对会话期限，单位毫秒；默认7天。
SESSION_MAX_AGE_MS=604800000
# 登录每IP、登录每账号限流；窗口单位毫秒。
AUTH_IP_LIMIT=30
AUTH_ACCOUNT_LIMIT=10
AUTH_RATE_WINDOW_MS=900000
# 生产设置NODE_ENV=production启用Secure Cookie，需要HTTPS。
# TRUST_PROXY只允许显式可信代理IP/子网列表；默认不信任X-Forwarded-For。
# TRUST_PROXY=loopback

# 唯一站主的用户UUID；留空拒绝所有配置读写和上传，不能填写账号数字。
# 先build，再通过stdin JSON运行npm run --silent site:owner:init，核对返回UUID后写入本地.env。
# 初始化只允许55555；已有账号需要正确原密码，不会重置密码。
SITE_OWNER_USER_ID=
# 图片、PDF、ZIP、TXT、Office附件与音频默认持久化到backend/.data/site-assets。
# 部署指定应用可写的独立持久目录绝对路径；备份整个目录（含下载名元数据），不要随发布删除。
# SITE_ASSETS_DIR=/absolute/path/to/persistent/site-assets

# AI对话仅站主后台可用；Key仅填在服务器，留空也可启动，但模型不可发送。
GLM_API_KEY=
# 默认免费GLM-4.7-Flash的兼容接口根地址；一般无需更改。
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 单轮生成总时限（1000–300000毫秒），默认120秒。
CHAT_TIMEOUT_MS=120000
# 可选最多10个额外兼容模型；id唯一且不能重复glm-4.7-flash。前端仅看到id/label/available。
# apiKeyEnv引用本文件中的服务端环境变量，不能把真实Key写进JSON或发送到前端。
# HTTPS为生产要求；回环HTTP只用于本地开发/测试。不会跟随重定向或自动回退到其他模型。
# CHAT_MODELS_JSON=[{"id":"other-model","label":"其他模型","model":"provider-model-id","baseUrl":"https://provider.example/v1","apiKeyEnv":"OTHER_LLM_API_KEY","disableThinking":false}]
# OTHER_LLM_API_KEY=
